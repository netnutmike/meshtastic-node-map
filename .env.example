# Environment Configuration for Meshtastic Node Mapper

# Application Settings
NODE_ENV=development
APP_NAME=Meshtastic Node Mapper
APP_VERSION=1.0.0

# Backend API Configuration
API_PORT=3001

# Authentication Configuration (Optional)
# Set AUTH_ENABLED=true to enable user authentication
# Leave commented out or set to false for public access
# AUTH_ENABLED=true
# JWT_SECRET=your-jwt-secret-change-in-production
# SESSION_SECRET=your-session-secret-change-in-production
# ALLOW_REGISTRATION=true

# Frontend Configuration
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:3001

# Database Configuration
DATABASE_URL=postgresql://meshtastic:meshtastic_password@localhost:5432/meshtastic_mapper
POSTGRES_DB=meshtastic_mapper
POSTGRES_USER=meshtastic
POSTGRES_PASSWORD=meshtastic_password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# MQTT Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=meshtastic-node-mapper

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security Configuration
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Map Configuration
DEFAULT_MAP_CENTER_LAT=40.7128
DEFAULT_MAP_CENTER_LNG=-74.0060
DEFAULT_MAP_ZOOM=10

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_COMPRESSION=true
ENABLE_HTTPS=false

# Public Access Configuration
# When authentication is disabled, all core features are publicly accessible
# Configuration is managed through YAML files in the config/ directory

# External Services
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=