# Production Environment Variables for villagesmesh.com

# Frontend API URLs (HTTP only - no SSL certificate installed)
REACT_APP_API_URL=http://villagesmesh.com/api
REACT_APP_WS_URL=ws://villagesmesh.com

# Backend Configuration
POSTGRES_DB=meshtastic_mapper
POSTGRES_USER=meshtastic
POSTGRES_PASSWORD=your_secure_password_here

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here

# JWT Secret (generate a secure random string)
JWT_SECRET=your_jwt_secret_here

# Frontend URL
FRONTEND_URL=https://villagesmesh.com

# Ports (default values, can be changed)
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Docker Registry (optional)
# DOCKER_REGISTRY=your-registry
# VERSION=latest
